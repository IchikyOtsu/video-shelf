# Added automatically by the Neon integration on Vercel.
# Locally, run `vercel env pull .env.local` after linking the project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Used by Vercel Cron to refresh YouTube feeds once per day.
CRON_SECRET=replace-with-another-long-random-secret

# Optional: YouTube Data API v3 key for more reliable channel name search.
# Without a key, search uses public YouTube results, which may be blocked by YouTube.
YOUTUBE_API_KEY=

# Transactional emails and public application address (required to send links).
EMAIL_FROM=Video Shelf <noreply@example.com>
RESEND_API_KEY=
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32. Required only when enabling TOTP.
TOTP_ENCRYPTION_KEY=

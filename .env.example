# Added automatically by the Neon integration on Vercel.
# Locally, run `vercel env pull .env.local` after linking the project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Used by Vercel Cron to refresh all active source kinds once per day.
CRON_SECRET=replace-with-another-long-random-secret

# Optional server-only YouTube Data API v3 key for search and dated video sync.
# API sync uses cached channels.list + playlistItems.list, then RSS/page backups.
# Without a key, sync uses RSS first. Never prefix this variable with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Transactional emails and public application address (required to send links).
EMAIL_FROM=Video Shelf <noreply@example.com>
RESEND_API_KEY=
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32. Required only when enabling TOTP.
TOTP_ENCRYPTION_KEY=
